# Database Configuration
# Replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF] with your Supabase credentials
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Upstash Redis Configuration
REDIS_URL=rediss://default:your_redis_token@your_redis_host:6379
